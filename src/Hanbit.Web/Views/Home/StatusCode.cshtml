@model StatusCodeViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["NoIndex"] = true;
}

<section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-16 text-center sm:py-24" data-testid="status-page" data-status="@Model.StatusCode">
    <p lang="ko" class="font-hangul text-5xl text-ink-muted sm:text-6xl" aria-hidden="true">@(Model.IsNotFound ? "어?" : "앗!")</p>
    <p class="mt-6 text-sm font-semibold text-secondary">Lỗi @Model.StatusCode</p>
    <h1 class="mt-2 text-2xl font-bold sm:text-3xl">@Model.Title</h1>
    <p class="mt-3 max-w-prose text-ink-muted">@Model.Message</p>
    <div class="mt-8 flex w-full justify-center">
        <hb-button href="/" size="lg" block="true" data-testid="status-home">Về trang chủ</hb-button>
    </div>
</section>
