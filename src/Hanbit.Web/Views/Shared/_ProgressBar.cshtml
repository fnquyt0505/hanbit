@model Hanbit.Web.Models.Shared.ProgressBarViewModel

<div class="h-2 w-full overflow-hidden rounded-full bg-border"
     role="progressbar" aria-label="@Model.Label"
     aria-valuemin="0" aria-valuemax="@Model.Max" aria-valuenow="@Model.Value">
    <div class="h-full rounded-full bg-secondary transition-[width] duration-300 ease-out"
         style="width: @(Model.Percent)%"></div>
</div>
