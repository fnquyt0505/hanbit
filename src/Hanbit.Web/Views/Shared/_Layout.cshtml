<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hanbit</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;700&family=Noto+Serif+KR:wght@400;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" crossorigin />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @* Module đăng ký component Alpine phải nạp TRƯỚC alpine.min.js (cùng là defer → chạy theo thứ tự). *@
    <script type="module" src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Head", required: false)
    <script defer src="~/lib/alpinejs/alpine.min.js" asp-append-version="true"></script>
</head>
<body class="bg-bg text-ink font-sans">
    <main role="main">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
