@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        // SEO (T7.4): canonical/Open Graph dùng URL gốc công khai (Site:BaseUrl), bỏ query string.
        var siteBase = Context.RequestServices.GetRequiredService<Microsoft.Extensions.Options.IOptions<Hanbit.Web.Hosting.SiteOptions>>().Value.ResolveBaseUrl(Context.Request);
        var pageTitle = $"{ViewData["Title"]} - Hanbit";
        var pageDescription = ViewData["Description"] as string ?? "Hanbit (한빛) — web học tiếng Hàn miễn phí cho người Việt.";
        var canonical = siteBase + Context.Request.Path;
    }
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    @if (ViewData["NoIndex"] is true)
    {
        <meta name="robots" content="noindex" />
    }
    else
    {
        <link rel="canonical" href="@canonical" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hanbit (한빛)" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@(siteBase)/img/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hanbit 한빛 — Học tiếng Hàn cho người Việt" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#faf7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14120f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    @* Áp chế độ sáng/tối đã lưu TRƯỚC khi vẽ (tránh nháy). Chỉ ĐỌC khóa do progress-store.js ghi — ngoại lệ đã chốt 2026-11-23. *@
    <script>@Html.Raw(Hanbit.Web.Hosting.InlineScripts.ThemeInit)</script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        @* T8.2: mã chống CSRF cho API ghi khi đã đăng nhập — api.js gửi qua header X-CSRF-TOKEN *@
        <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;700&family=Noto+Serif+KR:wght@400;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" crossorigin />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @* Module đăng ký component Alpine phải nạp TRƯỚC alpine.min.js (cùng là defer → chạy theo thứ tự). *@
    <script type="module" src="~/js/theme.js" asp-append-version="true"></script>
    <script type="module" src="~/js/ui.js" asp-append-version="true"></script>
    <script type="module" src="~/js/audio-button.js" asp-append-version="true"></script>
    <script type="module" src="~/js/progress-summary.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Head", required: false)
    <script defer src="~/lib/alpinejs/alpine.min.js" asp-append-version="true"></script>
</head>
<body class="bg-bg text-ink font-sans">
    <a href="#noi-dung" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:bg-surface focus:px-4 focus:py-2">
        Bỏ qua điều hướng
    </a>
    <partial name="_Sidebar" />
    <div class="flex min-h-dvh flex-col pb-[calc(3.5rem+env(safe-area-inset-bottom))] lg:pb-0 lg:pl-60">
        <header class="flex items-center justify-between border-b border-border bg-surface px-4 py-3 lg:hidden" data-testid="mobile-header">
            <a href="/" class="flex items-baseline gap-2 text-lg font-bold">
                Hanbit <span lang="ko" class="font-ko text-ink-muted">한빛</span>
            </a>
            <div class="flex items-center gap-2">
                <partial name="_StreakBadge" />
                <partial name="_AccountMenu" model="@("header")" />
            </div>
        </header>
        <main id="noi-dung" tabindex="-1" class="flex-1">
            @RenderBody()
        </main>
        <partial name="_Footer" />
    </div>
    <partial name="_BottomNav" />
    <partial name="_ToastRegion" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
