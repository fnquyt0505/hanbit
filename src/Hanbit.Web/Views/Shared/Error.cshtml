@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-16 text-center sm:py-24">
    <p lang="ko" class="font-hangul text-5xl text-ink-muted sm:text-6xl" aria-hidden="true">앗!</p>
    <h1 class="mt-6 text-2xl font-bold sm:text-3xl">Đã xảy ra lỗi</h1>
    <p class="mt-3 max-w-prose text-ink-muted">Rất tiếc, có lỗi khi xử lý yêu cầu của bạn. Vui lòng thử lại sau.</p>

    @if (Model.ShowRequestId)
    {
        <p class="mt-3 text-sm text-ink-muted">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }

    <div class="mt-8 flex w-full justify-center">
        <hb-button href="/" size="lg" block="true">Về trang chủ</hb-button>
    </div>
</section>
