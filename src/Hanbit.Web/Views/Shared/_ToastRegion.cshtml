@* Vùng hiển thị toast (Alpine store "toast" trong wwwroot/js/ui.js). Đặt 1 lần trong _Layout. *@
<div x-data role="status" aria-live="polite"
     class="pointer-events-none fixed inset-x-0 bottom-20 z-50 flex flex-col items-center gap-2 px-4 sm:bottom-6">
    <template x-for="item in $store.toast.items" x-bind:key="item.id">
        <div data-testid="toast" x-bind:data-kind="item.kind"
             class="pointer-events-auto flex w-full max-w-sm items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 text-ink shadow-sm">
            @* Đúng/sai luôn kèm icon, không chỉ dựa vào màu (DESIGN.md §2) *@
            <svg x-show="item.kind === 'success'" class="size-5 shrink-0 text-success-ink" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
            </svg>
            <svg x-show="item.kind === 'danger'" class="size-5 shrink-0 text-danger" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M4.3 4.3a1 1 0 0 1 1.4 0L10 8.6l4.3-4.3a1 1 0 1 1 1.4 1.4L11.4 10l4.3 4.3a1 1 0 0 1-1.4 1.4L10 11.4l-4.3 4.3a1 1 0 0 1-1.4-1.4L8.6 10 4.3 5.7a1 1 0 0 1 0-1.4Z" clip-rule="evenodd" />
            </svg>
            <svg x-show="item.kind === 'info'" class="size-5 shrink-0 text-secondary" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm1-11a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm-2 2.5a1 1 0 0 1 2 0V14a1 1 0 1 1-2 0V9.5Z" clip-rule="evenodd" />
            </svg>
            <p class="flex-1 text-sm" x-text="item.message"></p>
            <button type="button" class="rounded-full p-1 text-ink-muted" aria-label="Đóng thông báo"
                    x-on:click="$store.toast.dismiss(item.id)">
                <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M5.7 4.3a1 1 0 0 0-1.4 1.4L8.6 10l-4.3 4.3a1 1 0 1 0 1.4 1.4l4.3-4.3 4.3 4.3a1 1 0 0 0 1.4-1.4L11.4 10l4.3-4.3a1 1 0 0 0-1.4-1.4L10 8.6 5.7 4.3Z" />
                </svg>
            </button>
        </div>
    </template>
</div>
