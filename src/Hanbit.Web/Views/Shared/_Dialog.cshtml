@model Hanbit.Web.Models.Shared.DialogViewModel

<dialog id="@Model.Id" x-data="hbDialog('@Model.Id')" aria-labelledby="@(Model.Id)-title"
        x-on:click="closeOnBackdrop($event)"
        class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-border bg-surface p-6 text-ink shadow-sm backdrop:bg-ink/40">
    <h2 id="@(Model.Id)-title" class="text-xl font-semibold">@Model.Title</h2>
    <div class="mt-3">
        @Model.Body(null)
    </div>
    <form method="dialog" class="mt-6 flex justify-end">
        <hb-button variant="outline" type="submit">@Model.CloseLabel</hb-button>
    </form>
</dialog>
