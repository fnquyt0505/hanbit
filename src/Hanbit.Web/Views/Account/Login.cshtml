@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["NoIndex"] = true;
    ViewData["Description"] = "Đăng nhập Hanbit bằng Google để lưu tiến độ học trên mọi thiết bị.";
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/dashboard";
    var error = ViewData["Error"] as string;
}

<div class="mx-auto max-w-md px-4 py-12 sm:py-16" data-testid="login">
    <h1 class="text-3xl font-bold">Đăng nhập</h1>
    <p class="mt-3 text-ink-muted">Đăng nhập để lưu tiến độ lên tài khoản và học tiếp trên điện thoại, máy tính khác. Không đăng nhập bạn vẫn học bình thường — tiến độ lưu trên trình duyệt này.</p>

    @if (error is not null)
    {
        <p role="alert" class="mt-6 rounded-xl border border-danger p-4 text-danger" data-testid="login-error">@error</p>
    }

    <form asp-action="Google" method="post" class="mt-8">
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <button type="submit" data-testid="login-google"
                class="flex h-12 w-full items-center justify-center gap-3 rounded-full border border-border bg-surface px-6 text-lg font-semibold hover:border-secondary">
            <svg aria-hidden="true" class="size-5" viewBox="0 0 48 48">
                <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.6 5.4 2.6 13.3l7.9 6.2C12.4 13.7 17.7 9.5 24 9.5z" />
                <path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.2 5.3-4.6 7l7.2 5.6c4.2-3.9 7.1-9.6 7.1-17.1z" />
                <path fill="#FBBC05" d="M10.5 28.6c-.5-1.4-.8-3-.8-4.6s.3-3.2.8-4.6l-7.9-6.2C.9 16.6 0 20.2 0 24s.9 7.4 2.6 10.8l7.9-6.2z" />
                <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.2-5.6c-2 1.4-4.6 2.3-8.7 2.3-6.3 0-11.6-4.2-13.5-10l-7.9 6.2C6.6 42.6 14.6 48 24 48z" />
            </svg>
            Tiếp tục với Google
        </button>
    </form>

    <section class="mt-8 rounded-xl border border-border bg-surface p-4 text-sm text-ink-muted" aria-labelledby="privacy-title">
        <h2 id="privacy-title" class="font-semibold text-ink">Quyền riêng tư</h2>
        <p class="mt-1">Hanbit chỉ lưu <strong>tên hiển thị</strong>, <strong>email</strong> và mã tài khoản Google để đăng nhập, cùng tiến độ học của bạn. Không đăng bài, không đọc dữ liệu khác trong tài khoản Google.</p>
    </section>
</div>
